{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirelint.dev/schemas/secret-match-v1.schema.json",
  "title": "WireLinter Secret Match Recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sourceRefs", "secret", "candidate", "comparison"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "representation"],
      "properties": {
        "ref": { "$ref": "#/$defs/id" },
        "representation": { "const": "utf8" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fromHeader": { "$ref": "#/$defs/headerSource" },
        "fromQuery": { "$ref": "#/$defs/querySource" },
        "fromDecodedBody": { "$ref": "#/$defs/decodedBodySource" }
      },
      "oneOf": [
        { "required": ["fromHeader"] },
        { "required": ["fromQuery"] },
        { "required": ["fromDecodedBody"] }
      ]
    },
    "comparison": { "const": "constant-time-exact" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$" },
    "headerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cardinality"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cardinality": { "const": "exactly-one" }
      }
    },
    "querySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cardinality"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cardinality": { "const": "exactly-one" }
      }
    },
    "decodedBodySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}
