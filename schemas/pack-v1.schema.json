{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wirelint.dev/schemas/pack-v1.schema.json",
  "title": "WireLinter Provider Pack Protocol v1.x",
  "type": "object",
  "additionalProperties": false,
  "required": ["packProtocol", "id", "name", "packVersion", "providerDocsRevision", "capabilities", "docs", "rules"],
  "properties": {
    "packProtocol": { "enum": ["1.0", "1.1", "1.2", "1.3", "1.4"] },
    "id": { "$ref": "#/$defs/providerId" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "packVersion": { "$ref": "#/$defs/semver" },
    "providerDocsRevision": { "$ref": "#/$defs/nonEmptyString" },
    "minWireLinterVersion": { "$ref": "#/$defs/semver" },
    "capabilities": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "const": "passive-lint" } },
    "secrets": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/secret" } },
    "docs": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/doc" } },
    "schemas": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/relativePath" } },
    "signatures": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/relativePath" } },
    "secretMatches": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/relativePath" } },
    "digestMatches": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/relativePath" } },
    "rules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    { "if": { "properties": { "packProtocol": { "const": "1.0" } }, "required": ["packProtocol"] }, "then": { "not": { "required": ["signatures"] } } },
    { "if": { "properties": { "packProtocol": { "enum": ["1.0", "1.1", "1.2"] } }, "required": ["packProtocol"] }, "then": { "not": { "required": ["secretMatches"] } } },
    { "if": { "properties": { "packProtocol": { "enum": ["1.0", "1.1", "1.2", "1.3"] } }, "required": ["packProtocol"] }, "then": { "not": { "required": ["digestMatches"] } } }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$" },
    "providerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._/-]+$" },
    "secret": { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "required": { "type": "boolean", "default": true }, "description": { "$ref": "#/$defs/nonEmptyString" } } },
    "doc": { "type": "object", "additionalProperties": false, "required": ["url"], "properties": { "url": { "type": "string", "format": "uri" }, "revision": { "$ref": "#/$defs/nonEmptyString" }, "section": { "$ref": "#/$defs/nonEmptyString" } } }
  }
}
